{
  "schemaVersion": 1,
  "id": "rabbitboss",
  "version": "${version}",
  "name": "RabbitBoss",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/rabbitboss/icon.png",
